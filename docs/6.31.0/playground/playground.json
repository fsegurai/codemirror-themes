  "samples": [
    {
      "id": "themed-editor",
      "label": "Themed editor",
      "description": "A Markdown editor styled with the Tokyo Night Storm theme.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "theme-switcher",
      "label": "Theme switcher",
      "description": "Switches one editor between every packaged theme at runtime with a Compartment.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "light-dark",
      "label": "Light and dark pair",
      "description": "Follows the system color scheme with the GitHub Light and GitHub Dark themes.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "merge-view",
      "label": "Merge view",
      "description": "A side-by-side MergeView whose editors and revert buttons follow the selected theme.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "theme-gallery",
      "label": "Theme gallery",
      "description": "Every packaged theme side by side on the same snippet, filterable by dark and light.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "contrast-inspector",
      "label": "Contrast inspector",
      "description": "Measures WCAG contrast of the token colors and UI parts of the rendered editor, live in the browser.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "custom-theme",
      "label": "Custom theme",
      "description": "Builds a theme from a palette with EditorView.theme and HighlightStyle, and recolors one token of a packaged theme.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "override-styles",
      "label": "Override styles",
      "description": "Adjusts font size, line height and selection color on top of a packaged theme with Prec.highest.",
      "files": ["main.js", "styles.css", "index.html"]
    },
    {
      "id": "keyboard-focus",
      "label": "Keyboard focus",
      "description": "Shows the focus ring of the themes, how it behaves in forced-colors mode and how to navigate with the keyboard only.",
      "files": ["main.js", "styles.css", "index.html"]
    }
  ]
