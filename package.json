{
  "name": "@fsegurai/codemirror-themes",
  "version": "6.30.4",
  "description": "Theme packages for the CodeMirror editor",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Fabián Segura",
    "url": "https://www.fsegurai.com/"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0",
    "npm": ">=10"
  },
  "keywords": [
    "code",
    "codemirror",
    "codemirror-6",
    "diff",
    "diff-editor",
    "editor",
    "highlight",
    "javascript",
    "javascript-library",
    "library",
    "syntax",
    "typescript",
    "typescript-library",
    "themes",
    "abcdef",
    "abyss",
    "android-studio",
    "andromeda",
    "basic-dark",
    "basic-light",
    "bundle",
    "catppuccin-mocha",
    "cobalt2",
    "forest",
    "github-dark",
    "github-light",
    "gruvbox-dark",
    "gruvbox-light",
    "high-contrast-dark",
    "high-contrast-light",
    "material-dark",
    "material-light",
    "material-ocean",
    "monokai",
    "nord",
    "palenight",
    "solarized-dark",
    "solarized-light",
    "synthwave-84",
    "tokyo-night-day",
    "tokyo-night-storm",
    "volcano",
    "vscode-dark",
    "vscode-light"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "bun run clean",
    "build": "bun run build:packages && bun run build:packages:metadata && bun run build:demo && bun run build:demo:metadata",
    "build:packages": "bun run --filter '*' pkg:build",
    "build:demo": "vite build",
    "build:packages:metadata": "find ./packages -maxdepth 1 -type d ! -name '.helper' ! -name 'packages' -exec cp ./LICENSE {} \\;",
    "build:demo:metadata": "cp ./README.md ./demo/dist/README.md && cp ./LICENSE ./demo/dist/LICENSE",
    "clean": "bun run clean:packages && bun run clean:demo",
    "clean:packages": "rimraf --glob ./packages/*/dist",
    "clean:demo": "rimraf --glob ./demo/dist ./demo/README.md ./demo/LICENSE",
    "clean:coverage": "rimraf --glob ./coverage",
    "start": "vite",
    "start:dev": "portless run vite preview",
    "start:dev:reset": "portless proxy stop || true",
    "start:debug": "portless run vite --debug",
    "start:prod": "vite preview",
    "lint": "bun run lint:packages && bun run lint:demo",
    "lint:check": "biome check",
    "lint:fix": "biome check --write",
    "lint:packages": "biome lint packages/*/src/",
    "lint:demo": "biome lint demo/",
    "format": "biome check --write",
    "format:audit": "biome check",
    "generate:helpers": "bun packages/.helper/utils/generate-utils.ts",
    "generate:bundle": "bun packages/.helper/utils/generate-bundle.ts",
    "generate:readme": "bun packages/.helper/docs/generate-readme.ts",
    "version:update": "bun packages/.helper/versions/update-packages-versions.ts --write",
    "version:preview": "bun packages/.helper/versions/update-packages-versions.ts --dry-run",
    "version:skip": "bun packages/.helper/versions/update-packages-versions.ts --dry-run --skip '@fsegurai/codemirror-theme-bundle'"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@fsegurai/codemirror-theme-bundle": "workspace:*",
    "@material/web": "^2.5.0",
    "clipboard": "^2.0.11",
    "codemirror": "^6.0.2",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@codemirror/buildhelper": "^1.0.2",
    "@types/node": "26.2.0",
    "@types/prismjs": "^1.26.6",
    "portless": "^0.15.5",
    "rimraf": "^6.1.3",
    "terser": "^5.49.2",
    "typescript": "7.0.2",
    "vite": "^8.2.1"
  },
  "overrides": {
    "@codemirror/view": "6.43.8",
    "serialize-javascript": "7.0.5"
  }
}
