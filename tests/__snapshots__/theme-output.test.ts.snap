exports[`volcano editor UI rules 1`] = `
".ͼ0 { background-color: #390000; border: none; color: #F8F8F8; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #ff000035; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #550000; border: none; color: #F8F8F8; font-weight: 500 }
.ͼ0 .cm-button { background-color: #4a0000; background-image: none; border: none; border-radius: 4px; color: #F8F8F8; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #750000; border: none; box-shadow: 0 0 4px #ff550080; color: #F8F8F8 }
.ͼ0 .cm-changeGutter { background-color: #4a0000 }
.ͼ0 .cm-collapsedLines { background: #680000; color: #e7c0c0 }
.ͼ0 .cm-completionInfo { background-color: #680000; border: 1px solid #ec0d1e60; color: #F8F8F8; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #ec0d1e }
.ͼ0 .cm-content { caret-color: #970000; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #75000080; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #970000; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #970000; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #750000a0 }
.ͼ0 .cm-deletedLine { background-color: #750000a0; border-radius: 3px; color: #ec0d1e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #ec0d1e }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #ec0d1e }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #7df3f7 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #7df3f7 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #aa5507 }
.ͼ0 .cm-diagnosticAction { background-color: #4a0000; border: none; border-radius: 4px; color: #F8F8F8 }
.ͼ0 .cm-dropCursor { border-left-color: #970000; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #97000099; border: none; box-shadow: none; color: #390000 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #e7c0c0; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #F8F8F8 }
.ͼ0 .cm-foldPlaceholder { background-color: #680000; border: 1px dotted #e7c0c070; border-radius: 4px; color: #e7c0c0; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #e7c0c0; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #e7c0c0 }
.ͼ0 .cm-gutters { background-color: #4a0000; border: none; border-right: 1px solid #580000; color: #e7c0c0; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #e7c0c0 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #2a4a0080 }
.ͼ0 .cm-inlineChangedLineGutter { background: #9df39f }
.ͼ0 .cm-insertedLine { background-color: #2a4a0080; border-radius: 3px; color: #9df39f; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23ec0d1e%22%20stroke%3D%22%23390000%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%237df3f7%22%20stroke%3D%22%23390000%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23aa5507%22%20stroke%3D%22%23390000%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #ec0d1e }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #7df3f7 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #aa5507 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23ec0d1e%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%237df3f7%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%237df3f7%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23aa5507%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #ff550040; border-radius: 2px; box-shadow: none; outline: 1px solid #ec0d1e }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #750000a0 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #ec0d1e }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #2a4a0080 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #9df39f }
.ͼ0 .cm-mergeSpacer { background: #680000 }
.ͼ0 .cm-nonmatchingBracket { background-color: #ec0d1e40; border-radius: 2px; outline: 1px solid #ffffff }
.ͼ0 .cm-panel button { background-color: #4a0000; background-image: none; border: none; border-radius: 4px; color: #F8F8F8; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #750000; border: none; box-shadow: 0 0 4px #ff550080; color: #F8F8F8 }
.ͼ0 .cm-panel.cm-gotoLine { color: #F8F8F8; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #580000; border: none; border-radius: 4px; box-shadow: none; color: #F8F8F8 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 2px solid #390000 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 2px solid #390000 }
.ͼ0 .cm-placeholder { color: #e7c0c0 }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #750000; border: 3px solid #4a0000; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #ec0d1e; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #4a0000; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #F8F8F8; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #75000080; border-radius: 4px; box-shadow: none; color: #F8F8F8; outline: 1px solid #ec0d1e }
.ͼ0 .cm-searchMatch span { color: #F8F8F8 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #ec0d1e; box-shadow: none; color: #F8F8F8; outline: 1px solid #ec0d1e; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #F8F8F8 }
.ͼ0 .cm-selectionBackground { background-color: #75000080; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #7500009a; border-radius: 2px; outline: 1px solid #75000050 }
.ͼ0 .cm-snippetField { background-color: #7500009a; border-radius: 2px; outline: 1px dashed #75000050 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #970000 }
.ͼ0 .cm-specialChar { color: #ec0d1e }
.ͼ0 .cm-textfield { background-color: #390000; border: 1px solid #390000; border-radius: 4px; color: #F8F8F8; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #680000; border: 1px solid #ec0d1e60; border-radius: 4px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4); color: #F8F8F8; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #680000; border-top-color: #680000 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #680000; border: none }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #e7c0c0; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #e7c0c0; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #750000; border: none; border-radius: 3px; color: #F8F8F8 }
.ͼ0 .cm-tooltip-lint { color: #F8F8F8; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #ec0d1e60 }
.ͼ0 .cm-trailingSpace { background-color: #750000a0 }
.ͼ0 del { background-color: #750000a0 !important; border: 1px solid #ec0d1e40; border-radius: 3px; color: #ec0d1e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #750000a0 !important; border: 1px solid #ec0d1e40; border-radius: 3px; color: #ec0d1e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #750000a0 !important; border: 1px solid #ec0d1e40; border-radius: 3px; color: #ec0d1e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #2a4a0080 !important; border: 1px solid #9df39f40; border-radius: 3px; color: #9df39f; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #2a4a0080 !important; border: 1px solid #9df39f40; border-radius: 3px; color: #9df39f; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #75000080 }
.ͼ0.cm-focused { box-shadow: 0 0 0 2px #390000, 0 0 0 3px #ec0d1e70; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #75000080; outline: none }"
`;

exports[`volcano export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "volcano: object",
  "volcanoMergeStyles: object",
]
`;

