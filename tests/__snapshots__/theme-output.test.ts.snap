exports[`high-contrast-dark editor UI rules 1`] = `
".ͼ0 { background-color: #000000; border: 1px solid #b0b0b0; color: #ffffff; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #2a2a2a82; border-left: 3px solid #00ffff; border-radius: 2px; border-right: 1px solid #b0b0b0; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #1f1f1f; border: 1px solid #a1a1a1; color: #ffff00; font-weight: bold }
.ͼ0 .cm-button { background-color: #1a1a1a; background-image: none; border: 1px solid #b0b0b0; border-radius: 4px; color: #00ffff; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #1f1f1f; border: 1px solid #00ffff; box-shadow: none; color: #00ffff }
.ͼ0 .cm-changeGutter { background-color: #000000 }
.ͼ0 .cm-collapsedLines { background: #1a1a1a; color: #00ffff }
.ͼ0 .cm-completionInfo { background-color: #1a1a1a; border: 2px solid #00ffff; color: #ffffff; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #00ffff }
.ͼ0 .cm-content { caret-color: #ffff00; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #1a3865; outline: 2px solid #00ffff }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #ffff00; border-left-width: 3px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #ffff00; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #55000060 }
.ͼ0 .cm-deletedLine { background-color: #55000060; border-radius: 3px; color: #ff7967; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #ff7967 }
.ͼ0 .cm-diagnostic-error { background-color: #33000020; border-left: 4px solid #ff7967 }
.ͼ0 .cm-diagnostic-hint { border-left: 4px solid #00ffff }
.ͼ0 .cm-diagnostic-info { background-color: #00333320; border-left: 4px solid #00ffff }
.ͼ0 .cm-diagnostic-warning { background-color: #33330020; border-left: 4px solid #ffff00 }
.ͼ0 .cm-diagnosticAction { background-color: #1a1a1a; border: 1px solid #b0b0b0; border-radius: 4px; color: #00ffff }
.ͼ0 .cm-dropCursor { border-left-color: #ffff00; border-left-width: 3px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #ffff00; border: 2px solid #ffffff; box-shadow: none; color: #000000 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #b0b0b0; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #00ffff }
.ͼ0 .cm-foldPlaceholder { background-color: #1a1a1a; border: 2px solid #00ffff; border-radius: 4px; color: #00ffff; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #a1a1a1; opacity: 0.7 }
.ͼ0 .cm-gutter-lint { color: #b0b0b0 }
.ͼ0 .cm-gutters { background-color: #000000; border: none; border-right: 2px solid #b0b0b0; color: #b0b0b0; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #b0b0b0 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #00550060 }
.ͼ0 .cm-inlineChangedLineGutter { background: #00ff00 }
.ͼ0 .cm-insertedLine { background-color: #00550060; border-radius: 3px; color: #00ff00; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23ff7967%22%20stroke%3D%22%23000000%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%2300ffff%22%20stroke%3D%22%23000000%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23ffff00%22%20stroke%3D%22%23000000%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 3px wavy #ff7967 }
.ͼ0 .cm-lintPoint-info { border-bottom: 3px wavy #00ffff }
.ͼ0 .cm-lintPoint-warning { border-bottom: 3px wavy #ffff00 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23ff7967%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2300ffff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2300ffff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23ffff00%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #1f1f1f; border-radius: 2px; box-shadow: none; outline: 2px solid #00ffff }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #55000060 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #ff7967 }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #00550060 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #00ff00 }
.ͼ0 .cm-mergeSpacer { background: #000000 }
