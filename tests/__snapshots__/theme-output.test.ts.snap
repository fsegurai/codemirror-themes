exports[`vscode-dark editor UI rules 1`] = `
".ͼ0 { background-color: #1e1e1e; border: none; color: #d4d4d4; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #FFFFFF08; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #FFFFFF08; border: none; color: #e9e9e9; font-weight: 500 }
.ͼ0 .cm-button { background-color: #2d2d30; background-image: none; border: 1px solid #2d2d30; border-radius: 4px; color: #d4d4d4; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #3a3a3a; border: 1px solid #83838380; box-shadow: none; color: #d4d4d4 }
.ͼ0 .cm-changeGutter { background-color: #1c1c1c }
.ͼ0 .cm-collapsedLines { background: #252526; color: #838383 }
.ͼ0 .cm-completionInfo { background-color: #252526; border: 1px solid #2d2d30; color: #d4d4d4; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #569cd680 }
.ͼ0 .cm-content { caret-color: #c6c6c6; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #264F7899; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #c6c6c6; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #c6c6c6; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #4b1c1c80 }
.ͼ0 .cm-deletedLine { background-color: #4b1c1c80; border-radius: 3px; color: #f14c4c; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #f14c4c }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #f44747 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #3794ff }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #3794ff }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #d7ba7d }
.ͼ0 .cm-diagnosticAction { background-color: #2d2d30; border: 1px solid #2d2d30; border-radius: 4px; color: #d4d4d4 }
.ͼ0 .cm-dropCursor { border-left-color: #c6c6c6; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #c6c6c699; border: none; box-shadow: none; color: #1e1e1e }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #838383; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #e9e9e9 }
.ͼ0 .cm-foldPlaceholder { background-color: #252526; border: 1px dotted #83838370; border-radius: 4px; color: #838383; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #838383; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #838383 }
.ͼ0 .cm-gutters { background-color: #1c1c1c; border: none; border-right: 1px solid #2d2d30; color: #838383; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #838383 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #1e3f1e80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #6cc26f }
.ͼ0 .cm-insertedLine { background-color: #1e3f1e80; border-radius: 3px; color: #6cc26f; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23f44747%22%20stroke%3D%22%231e1e1e%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%233794ff%22%20stroke%3D%22%231e1e1e%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23d7ba7d%22%20stroke%3D%22%231e1e1e%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #f44747 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #3794ff }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #d7ba7d }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23f44747%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%233794ff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%233794ff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23d7ba7d%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #ffffff15; border-radius: 2px; box-shadow: none; outline: 1px solid #569cd680 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #4b1c1c80 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #f14c4c }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #1e3f1e80 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #6cc26f }
.ͼ0 .cm-mergeSpacer { background: #252526 }
.ͼ0 .cm-nonmatchingBracket { background-color: #f4474740; border-radius: 2px; outline: 1px solid #f44747 }
.ͼ0 .cm-panel button { background-color: #2d2d30; background-image: none; border: 1px solid #2d2d30; border-radius: 4px; color: #d4d4d4; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #3a3a3a; border: 1px solid #83838380; box-shadow: none; color: #d4d4d4 }
.ͼ0 .cm-panel.cm-gotoLine { color: #d4d4d4; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #252526; border: none; border-radius: 4px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45); color: #d4d4d4 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 1px solid #2d2d30 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 1px solid #2d2d30 }
.ͼ0 .cm-placeholder { color: #838383 }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #424242; border: 3px solid #1e1e1e; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #525252; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #1e1e1e; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #d4d4d4; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #72a1ff40; border-radius: 4px; box-shadow: none; color: #e9e9e9; outline: 1px solid #569cd690 }
.ͼ0 .cm-searchMatch span { color: #e9e9e9 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #3794ff90; box-shadow: none; color: #e9e9e9; outline: 1px solid #569cd690; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #e9e9e9 }
.ͼ0 .cm-selectionBackground { background-color: #264F7899; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #72a1ff59; border-radius: 2px; outline: 1px solid #2d2d3070 }
.ͼ0 .cm-snippetField { background-color: #72a1ff59; border-radius: 2px; outline: 1px dashed #2d2d3070 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #c6c6c6 }
.ͼ0 .cm-specialChar { color: #f44747 }
.ͼ0 .cm-textfield { background-color: #1e1e1e; border: 1px solid #2d2d30; border-radius: 4px; color: #d4d4d4; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #252526; border: 1px solid #2d2d30; border-radius: 4px; box-shadow: 0 3px 8px rgba(0, 0, 0, 0.3); color: #d4d4d4; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #252526; border-top-color: #252526 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #252526; border: none }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #838383; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #838383; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #04395e; border: none; border-radius: 3px; color: #e9e9e9 }
.ͼ0 .cm-tooltip-lint { color: #d4d4d4; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #2d2d30 }
.ͼ0 .cm-trailingSpace { background-color: #4b1c1c80 }
.ͼ0 del { background-color: #4b1c1c80 !important; border: 1px solid #f14c4c40; border-radius: 3px; color: #f14c4c; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #4b1c1c80 !important; border: 1px solid #f14c4c40; border-radius: 3px; color: #f14c4c; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #4b1c1c80 !important; border: 1px solid #f14c4c40; border-radius: 3px; color: #f14c4c; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #1e3f1e80 !important; border: 1px solid #6cc26f40; border-radius: 3px; color: #6cc26f; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #1e3f1e80 !important; border: 1px solid #6cc26f40; border-radius: 3px; color: #6cc26f; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #264F7899 }
.ͼ0.cm-focused { box-shadow: 0 0 0 1px #2d2d30; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #264F7899; outline: none }"
`;

