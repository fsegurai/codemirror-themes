exports[`solarized-light editor UI rules 1`] = `
".ͼ0 { background-color: #fdf6e3; border: none; color: #657b83; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #cceeff7a; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #cceeff7a; border: none; color: #657b83; font-weight: 500 }
.ͼ0 .cm-button { background-color: #f0e9d7; background-image: none; border: none; border-radius: 4px; color: #657b83; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #cceeff7a; border: none; box-shadow: none; color: #657b83 }
.ͼ0 .cm-changeGutter { background-color: #dfd9c8 }
.ͼ0 .cm-collapsedLines { background: #f0e9d7; color: #002b36 }
.ͼ0 .cm-completionInfo { background-color: #f0e9d7; border: 1px solid #586e75; color: #657b83; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #268bd2 }
.ͼ0 .cm-content { caret-color: #586e75; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #ffd07a; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #586e75; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #586e75; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #dc322f20 }
.ͼ0 .cm-deletedLine { background-color: #dc322f20; border-radius: 3px; color: #dc322f; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #dc322f }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #dc322f }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #268bd2 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #268bd2 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #b58900 }
.ͼ0 .cm-diagnosticAction { background-color: #f0e9d7; border: none; border-radius: 4px; color: #657b83 }
.ͼ0 .cm-dropCursor { border-left-color: #586e75; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #586e7599; border: none; box-shadow: none; color: #fdf6e3 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #586e75; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #657b83 }
.ͼ0 .cm-foldPlaceholder { background-color: #f0e9d7; border: 1px dotted #93a1a170; border-radius: 4px; color: #002b36; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #586e75; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #586e75 }
.ͼ0 .cm-gutters { background-color: #dfd9c8; border: none; border-right: 1px solid #dfd9c8; color: #586e75; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #586e75 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #85990020 }
.ͼ0 .cm-inlineChangedLineGutter { background: #859900 }
.ͼ0 .cm-insertedLine { background-color: #85990020; border-radius: 3px; color: #859900; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23dc322f%22%20stroke%3D%22%23fdf6e3%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23268bd2%22%20stroke%3D%22%23fdf6e3%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23b58900%22%20stroke%3D%22%23fdf6e3%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #dc322f }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #268bd2 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #b58900 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23dc322f%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23268bd2%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23268bd2%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
