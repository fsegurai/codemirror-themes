.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #96a4b2; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #96a4b2; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #ffffff1f; border: none; border-radius: 3px; color: #e0e0e0 }
.ͼ0 .cm-tooltip-lint { color: #bdbdbd; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #96a4b2 }
.ͼ0 .cm-trailingSpace { background-color: #4e282880 }
.ͼ0 del { background-color: #4e282880 !important; border: 1px solid #fc7c6e40; border-radius: 3px; color: #fc7c6e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #4e282880 !important; border: 1px solid #fc7c6e40; border-radius: 3px; color: #fc7c6e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #4e282880 !important; border: 1px solid #fc7c6e40; border-radius: 3px; color: #fc7c6e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #1e3d2780 !important; border: 1px solid #6abf6940; border-radius: 3px; color: #6abf69; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #1e3d2780 !important; border: 1px solid #6abf6940; border-radius: 3px; color: #6abf69; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #ffffff1c }
.ͼ0.cm-focused { box-shadow: 0 0 0 2px #212121, 0 0 0 3px #56c8d840; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #ffffff1c; outline: none }"
`;

exports[`material-dark export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "materialDark: object",
  "materialDarkMergeStyles: object",
]
`;

