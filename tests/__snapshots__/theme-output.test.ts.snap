exports[`monokai editor UI rules 1`] = `
".ͼ0 { background-color: #272822; border: none; color: #f8f8f2; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #3e3d3257; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #35352c; border: none; color: #f8f8f2; font-weight: 500 }
