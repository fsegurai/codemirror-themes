exports[`vscode-light editor UI rules 1`] = `
".ͼ0 { background-color: #ffffff; border: none; color: #383a42; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #99999926; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #99999926; border: none; color: #0b216f; font-weight: 500 }
.ͼ0 .cm-button { background-color: #ffffff; background-image: none; border: 1px solid #d6d6d6; border-radius: 4px; color: #383a42; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #e8e8e8; border: 1px solid #6b6b6b80; box-shadow: none; color: #383a42 }
.ͼ0 .cm-changeGutter { background-color: #f5f5f5 }
.ͼ0 .cm-collapsedLines { background: #f3f3f3; color: #6b6b6b }
.ͼ0 .cm-completionInfo { background-color: #f3f3f3; border: 1px solid #d6d6d6; color: #383a42; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #007acc80 }
.ͼ0 .cm-content { caret-color: #000000; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #add6ff; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #000000; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #000000; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #ffebec }
.ͼ0 .cm-deletedLine { background-color: #ffebec; border-radius: 3px; color: #e51400; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #e51400 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #e51400 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #006ab1 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #006ab1 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #bf8803 }
.ͼ0 .cm-diagnosticAction { background-color: #ffffff; border: 1px solid #d6d6d6; border-radius: 4px; color: #383a42 }
.ͼ0 .cm-dropCursor { border-left-color: #000000; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #00000099; border: none; box-shadow: none; color: #ffffff }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #237893; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #0b216f }
.ͼ0 .cm-foldPlaceholder { background-color: #f3f3f3; border: 1px dotted #6b6b6b70; border-radius: 4px; color: #6b6b6b; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #6b6b6b; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #237893 }
.ͼ0 .cm-gutters { background-color: #f5f5f5; border: none; border-right: 1px solid #d6d6d6; color: #237893; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #237893 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #ddfbe0 }
.ͼ0 .cm-inlineChangedLineGutter { background: #22863a }
.ͼ0 .cm-insertedLine { background-color: #ddfbe0; border-radius: 3px; color: #22863a; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23e51400%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23006ab1%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23bf8803%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #e51400 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #006ab1 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #bf8803 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23e51400%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23006ab1%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23006ab1%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23bf8803%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #007acc20; border-radius: 2px; box-shadow: none; outline: 1px solid #007acc80 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #ffebec }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #e51400 }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #ddfbe0 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #22863a }
.ͼ0 .cm-mergeSpacer { background: #f3f3f3 }
.ͼ0 .cm-nonmatchingBracket { background-color: #e5140020; border-radius: 2px; outline: 1px solid #e51400 }
.ͼ0 .cm-panel button { background-color: #ffffff; background-image: none; border: 1px solid #d6d6d6; border-radius: 4px; color: #383a42; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #e8e8e8; border: 1px solid #6b6b6b80; box-shadow: none; color: #383a42 }
.ͼ0 .cm-panel.cm-gotoLine { color: #383a42; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #f3f3f3; border: none; border-radius: 4px; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15); color: #383a42 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 1px solid #d6d6d6 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 1px solid #d6d6d6 }
.ͼ0 .cm-placeholder { color: #6b6b6b }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #dadada; border: 3px solid #ffffff; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #cccccc; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #ffffff; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #383a42; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #bbdefb; border-radius: 4px; box-shadow: none; color: #1f1f1f; outline: 1px solid #0070c190 }
.ͼ0 .cm-searchMatch span { color: #1f1f1f }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #90caf9; box-shadow: none; color: #1f1f1f; outline: 1px solid #0070c190; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #1f1f1f }
.ͼ0 .cm-selectionBackground { background-color: #add6ff; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #a8ac9480; border-radius: 2px; outline: 1px solid #d6d6d670 }
.ͼ0 .cm-snippetField { background-color: #a8ac9480; border-radius: 2px; outline: 1px dashed #d6d6d670 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #000000 }
.ͼ0 .cm-specialChar { color: #e51400 }
.ͼ0 .cm-textfield { background-color: #ffffff; border: 1px solid #d6d6d6; border-radius: 4px; color: #383a42; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #f3f3f3; border: 1px solid #d6d6d6; border-radius: 4px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15); color: #383a42; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #f3f3f3; border-top-color: #f3f3f3 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #f3f3f3; border: none }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #6b6b6b; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #6b6b6b; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #dcebfc; border: none; border-radius: 3px; color: #1f1f1f }
.ͼ0 .cm-tooltip-lint { color: #383a42; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #d6d6d6 }
.ͼ0 .cm-trailingSpace { background-color: #ffebec }
.ͼ0 del { background-color: #ffebec !important; border: 1px solid #e5140040; border-radius: 3px; color: #e51400; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #ffebec !important; border: 1px solid #e5140040; border-radius: 3px; color: #e51400; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #ffebec !important; border: 1px solid #e5140040; border-radius: 3px; color: #e51400; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #ddfbe0 !important; border: 1px solid #22863a40; border-radius: 3px; color: #22863a; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #ddfbe0 !important; border: 1px solid #22863a40; border-radius: 3px; color: #22863a; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #add6ff }
.ͼ0.cm-focused { box-shadow: 0 0 0 1px #d6d6d6; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #add6ff; outline: none }"
`;

exports[`vscode-light export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "vsCodeLight: object",
  "vsCodeLightMergeStyles: object",
]
`;
