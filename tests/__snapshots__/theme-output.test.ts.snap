exports[`gruvbox-dark editor UI rules 1`] = `
".ͼ0 { background-color: #282828; border: none; color: #ebdbb2; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #3c383660; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #3c3836; border: none; color: #ebdbb2; font-weight: 500 }
.ͼ0 .cm-button { background-color: #3c3836; background-image: none; border: none; border-radius: 4px; color: #ebdbb2; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #504945; border: none; box-shadow: none; color: #ebdbb2 }
.ͼ0 .cm-changeGutter { background-color: #3c3836 }
.ͼ0 .cm-collapsedLines { background: #3c3836; color: #928374 }
.ͼ0 .cm-completionInfo { background-color: #3c3836; border: 1px solid #665c54; color: #ebdbb2; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #fabd2f }
.ͼ0 .cm-content { caret-color: #fe8019; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #504945; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #fe8019; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #fe8019; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #3c1f1e80 }
.ͼ0 .cm-deletedLine { background-color: #3c1f1e80; border-radius: 3px; color: #fb4934; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #fb4934 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #fb4934 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #83a598 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #83a598 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #fabd2f }
.ͼ0 .cm-diagnosticAction { background-color: #3c3836; border: none; border-radius: 4px; color: #ebdbb2 }
.ͼ0 .cm-dropCursor { border-left-color: #fe8019; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #fe801999; border: none; box-shadow: none; color: #282828 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #928374; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #ebdbb2 }
.ͼ0 .cm-foldPlaceholder { background-color: #3c3836; border: 1px dotted #665c54; border-radius: 4px; color: #928374; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #928374; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #928374 }
.ͼ0 .cm-gutters { background-color: #3c3836; border: none; border-right: 1px solid #504945; color: #928374; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #928374 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #32361a80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #b8bb26 }
.ͼ0 .cm-insertedLine { background-color: #32361a80; border-radius: 3px; color: #b8bb26; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23fb4934%22%20stroke%3D%22%23282828%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%2383a598%22%20stroke%3D%22%23282828%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23fabd2f%22%20stroke%3D%22%23282828%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #fb4934 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #83a598 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #fabd2f }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23fb4934%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2383a598%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2383a598%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23fabd2f%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #504945cc; border-radius: 2px; box-shadow: none; outline: 1px solid #fabd2f }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #3c1f1e80 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #fb4934 }
