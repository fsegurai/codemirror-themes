exports[`volcano editor UI rules 1`] = `
".ͼ0 { background-color: #390000; border: none; color: #F8F8F8; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #ff00001f; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #550000; border: none; color: #F8F8F8; font-weight: 500 }
.ͼ0 .cm-button { background-color: #4a0000; background-image: none; border: none; border-radius: 4px; color: #F8F8F8; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #750000; border: none; box-shadow: 0 0 4px #ff550080; color: #F8F8F8 }
