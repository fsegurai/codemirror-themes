.ͼ0 .cm-panel button:hover { background-color: #504945; border: none; box-shadow: none; color: #ebdbb2 }
.ͼ0 .cm-panel.cm-gotoLine { color: #ebdbb2; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #3c3836; border: none; border-radius: 4px; box-shadow: none; color: #ebdbb2 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 1px solid #665c54 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 1px solid #665c54 }
.ͼ0 .cm-placeholder { color: #928374 }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #665c54; border: 3px solid #3c3836; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #7c6f64; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #3c3836; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #ebdbb2; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #b57614cc; border-radius: 4px; box-shadow: none; color: #fbf1c7; outline: 1px solid #fabd2f }
.ͼ0 .cm-searchMatch span { color: #fbf1c7 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #fe8019; box-shadow: none; color: #282828; outline: 1px solid #fabd2f; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #282828 }
.ͼ0 .cm-selectionBackground { background-color: #504945; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #665c5480; border-radius: 2px; outline: 1px solid #665c54 }
.ͼ0 .cm-snippetField { background-color: #665c5480; border-radius: 2px; outline: 1px dashed #665c54 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #fe8019 }
.ͼ0 .cm-specialChar { color: #fb4934 }
.ͼ0 .cm-textfield { background-color: #282828; border: 1px solid #665c54; border-radius: 4px; color: #ebdbb2; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #3c3836; border: 1px solid #665c54; border-radius: 4px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3); color: #ebdbb2; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #3c3836; border-top-color: #3c3836 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #3c3836; border: none }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
