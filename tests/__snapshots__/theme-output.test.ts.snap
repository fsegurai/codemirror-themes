exports[`high-contrast-light editor UI rules 1`] = `
".ͼ0 { background-color: #ffffff; border: 2px solid #000000; color: #000000; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #ffffccba; border-left: 3px solid #0000ff; border-radius: 2px; border-right: 1px solid #4f4f4f; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #e0e0e0; border: 1px solid #4f4f4f; color: #0000ff; font-weight: bold }
.ͼ0 .cm-button { background-color: #f0f0f0; background-image: none; border: 2px solid #000000; border-radius: 4px; color: #0000ff; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #e0e0e0; border: 2px solid #0000ff; box-shadow: none; color: #0000ff }
.ͼ0 .cm-changeGutter { background-color: #ffffff }
.ͼ0 .cm-collapsedLines { background: #f0f0f0; color: #0000ff }
.ͼ0 .cm-completionInfo { background-color: #f0f0f0; border: 2px solid #0000ff; color: #000000; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #095959 }
.ͼ0 .cm-content { caret-color: #0000ff; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #9fc3fe; outline: 2px solid #0000ff }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #0000ff; border-left-width: 3px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #0000ff; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #c8000040 }
.ͼ0 .cm-deletedLine { background-color: #c8000040; border-radius: 3px; color: #a40000; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #a40000 }
.ͼ0 .cm-diagnostic-error { background-color: #ff000020; border-left: 4px solid #a40000 }
.ͼ0 .cm-diagnostic-hint { border-left: 4px solid #0000ff }
.ͼ0 .cm-diagnostic-info { background-color: #0000ff20; border-left: 4px solid #0000ff }
.ͼ0 .cm-diagnostic-warning { background-color: #ff990020; border-left: 4px solid #8e3003 }
.ͼ0 .cm-diagnosticAction { background-color: #f0f0f0; border: 2px solid #000000; border-radius: 4px; color: #0000ff }
.ͼ0 .cm-dropCursor { border-left-color: #0000ff; border-left-width: 3px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #0000ff; border: 2px solid #000000; box-shadow: none; color: #ffffff }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #505050; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #095959 }
.ͼ0 .cm-foldPlaceholder { background-color: #f0f0f0; border: 2px solid #0000ff; border-radius: 4px; color: #0000ff; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #4f4f4f; opacity: 0.7 }
.ͼ0 .cm-gutter-lint { color: #505050 }
.ͼ0 .cm-gutters { background-color: #ffffff; border: none; border-right: 2px solid #000000; color: #505050; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #505050 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #00800040 }
.ͼ0 .cm-inlineChangedLineGutter { background: #0e5d0c }
.ͼ0 .cm-insertedLine { background-color: #00800040; border-radius: 3px; color: #0e5d0c; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23a40000%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%230000ff%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%238e3003%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 3px wavy #a40000 }
.ͼ0 .cm-lintPoint-info { border-bottom: 3px wavy #0000ff }
.ͼ0 .cm-lintPoint-warning { border-bottom: 3px wavy #8e3003 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23a40000%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%230000ff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%230000ff%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%238e3003%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #e0e0e0; border-radius: 2px; box-shadow: none; outline: 2px solid #095959 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #c8000040 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #a40000 }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #00800040 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #0e5d0c }
.ͼ0 .cm-mergeSpacer { background: #ffffff }
.ͼ0 .cm-nonmatchingBracket { background-color: #ff000030; border-radius: 2px; outline: 2px solid #a40000 }
.ͼ0 .cm-panel button { background-color: #f0f0f0; background-image: none; border: 2px solid #000000; border-radius: 4px; color: #0000ff; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #e0e0e0; border: 2px solid #0000ff; box-shadow: none; color: #0000ff }
.ͼ0 .cm-panel.cm-gotoLine { color: #000000; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #ffffff; border: 2px solid #000000; border-radius: 4px; box-shadow: none; color: #000000 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 2px solid #000000 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 2px solid #000000 }
.ͼ0 .cm-placeholder { color: #4f4f4f }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #505050; border: 2px solid #000000; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #0000ff; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #ffffff; border: 2px solid #000000 }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #000000; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #ffff00; border-radius: 4px; box-shadow: none; color: #000000; outline: 2px solid #8e3003 }
.ͼ0 .cm-searchMatch span { color: #000000 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #8e3003; box-shadow: none; color: #ffffff; outline: 2px solid #000000; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #ffffff }
.ͼ0 .cm-selectionBackground { background-color: #9fc3fe; outline: 2px solid #0000ff }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #0078d480; border-radius: 2px; outline: 2px solid #0000ff50 }
.ͼ0 .cm-snippetField { background-color: #0078d480; border-radius: 2px; outline: 1px dashed #0000ff50 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #0000ff }
.ͼ0 .cm-specialChar { color: #a40000 }
.ͼ0 .cm-textfield { background-color: #ffffff; border: 2px solid #000000; border-radius: 4px; color: #000000; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #f0f0f0; border: 2px solid #0000ff; border-radius: 4px; box-shadow: none; color: #000000; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #f0f0f0; border-top-color: #f0f0f0 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #f0f0f0; border: 2px solid #000000 }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #8e3003; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #095959; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #0078d4; border: 2px solid #0000ff; border-radius: 3px; color: #ffffff }
.ͼ0 .cm-tooltip-lint { color: #000000; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #0000ff }
.ͼ0 .cm-trailingSpace { background-color: #c8000040 }
.ͼ0 del { background-color: #c8000040 !important; border: 2px solid #a40000; border-radius: 3px; color: #a40000; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #c8000040 !important; border: 2px solid #a40000; border-radius: 3px; color: #a40000; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #c8000040 !important; border: 2px solid #a40000; border-radius: 3px; color: #a40000; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #00800040 !important; border: 2px solid #0e5d0c; border-radius: 3px; color: #0e5d0c; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #00800040 !important; border: 2px solid #0e5d0c; border-radius: 3px; color: #0e5d0c; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #9fc3fe }
.ͼ0.cm-focused { box-shadow: 0 0 0 2px #ffffff, 0 0 0 5px #0000ff; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #9fc3fe; outline: 2px solid #0000ff }"
`;

exports[`high-contrast-light export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "highContrastLight: object",
  "highContrastLightMergeStyles: object",
]
`;

