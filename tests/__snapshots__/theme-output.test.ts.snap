exports[`github-dark editor UI rules 1`] = `
".ͼ0 { background-color: #0d1117; border: none; color: #c9d1d9; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #2d333b1a; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #21262d; border: none; color: #c9d1d9; font-weight: 500 }
.ͼ0 .cm-button { background-color: #21262d; background-image: none; border: none; border-radius: 4px; color: #c9d1d9; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #2c333a; border: none; box-shadow: none; color: #c9d1d9 }
.ͼ0 .cm-changeGutter { background-color: #161b22 }
.ͼ0 .cm-collapsedLines { background: #21262d; color: #8b949e }
.ͼ0 .cm-completionInfo { background-color: #21262d; border: 1px solid #30363d; color: #c9d1d9; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #4d90fe }
.ͼ0 .cm-content { caret-color: #ffffff; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #264F78; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #ffffff; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #ffffff; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #f8514940 }
.ͼ0 .cm-deletedLine { background-color: #f8514940; border-radius: 3px; color: #ff7b72; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #ff7b72 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #f97583 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #58a6ff }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #58a6ff }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #d29922 }
.ͼ0 .cm-diagnosticAction { background-color: #21262d; border: none; border-radius: 4px; color: #c9d1d9 }
.ͼ0 .cm-dropCursor { border-left-color: #ffffff; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #ffffff99; border: none; box-shadow: none; color: #0d1117 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #8b949e; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #c9d1d9 }
.ͼ0 .cm-foldPlaceholder { background-color: #21262d; border: 1px dotted #30363d70; border-radius: 4px; color: #8b949e; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #8b949e; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #8b949e }
.ͼ0 .cm-gutters { background-color: #161b22; border: none; border-right: 1px solid #30363d; color: #8b949e; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #8b949e 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #2ea04350 }
.ͼ0 .cm-inlineChangedLineGutter { background: #7ee787 }
.ͼ0 .cm-insertedLine { background-color: #2ea04350; border-radius: 3px; color: #7ee787; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
