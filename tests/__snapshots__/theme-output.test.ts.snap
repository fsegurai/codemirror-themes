.ͼ0 .cm-inlineChangedLine { background-color: #1e3d2780 }
.ͼ0 .cm-inlineChangedLineGutter { background: #6abf69 }
.ͼ0 .cm-insertedLine { background-color: #1e3d2780; border-radius: 3px; color: #6abf69; padding: 1px 3px; text-decoration: none }
