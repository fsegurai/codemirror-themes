exports[`gruvbox-light editor UI rules 1`] = `
".ͼ0 { background-color: #fbf1c7; border: none; color: #3c3836; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #ffc42e25; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #d5c4a1; border: none; color: #3c3836; font-weight: 500 }
.ͼ0 .cm-button { background-color: #fbf1c7; background-image: none; border: none; border-radius: 4px; color: #3c3836; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #d5c4a1; border: none; box-shadow: none; color: #3c3836 }
.ͼ0 .cm-changeGutter { background-color: #ebdbb2 }
.ͼ0 .cm-collapsedLines { background: transparent; color: #665c54 }
.ͼ0 .cm-completionInfo { background-color: #ebdbb2; border: 1px solid #bdae93; color: #3c3836; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #af3a03 }
.ͼ0 .cm-content { caret-color: #af3a03; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #ebdbb2; color: #3c3836; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #af3a03; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #af3a03; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #f7cfcf80 }
.ͼ0 .cm-deletedLine { background-color: #f7cfcf80; border-radius: 3px; color: #9d0006; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #9d0006 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #9d0006 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #076678 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #076678 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #b57614 }
.ͼ0 .cm-diagnosticAction { background-color: #fbf1c7; border: none; border-radius: 4px; color: #3c3836 }
.ͼ0 .cm-dropCursor { border-left-color: #af3a03; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #af3a0399; border: none; box-shadow: none; color: #fbf1c7 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #7c6f64; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #3c3836 }
.ͼ0 .cm-foldPlaceholder { background-color: transparent; border: 1px dotted #bdae93; border-radius: 4px; color: #665c54; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #928374; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #7c6f64 }
.ͼ0 .cm-gutters { background-color: #ebdbb2; border: none; border-right: 1px solid #bdae93; color: #7c6f64; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #7c6f64 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #d8e5bc80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #79740e }
.ͼ0 .cm-insertedLine { background-color: #d8e5bc80; border-radius: 3px; color: #79740e; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%239d0006%22%20stroke%3D%22%23fbf1c7%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23076678%22%20stroke%3D%22%23fbf1c7%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23b57614%22%20stroke%3D%22%23fbf1c7%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #9d0006 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #076678 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #b57614 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%239d0006%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23076678%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23076678%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23b57614%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #d5c4a180; border-radius: 2px; box-shadow: none; outline: 1px solid #af3a03 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #f7cfcf80 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #9d0006 }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #d8e5bc80 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #79740e }
.ͼ0 .cm-mergeSpacer { background: #ebdbb2 }
.ͼ0 .cm-nonmatchingBracket { background-color: #fb492740; border-radius: 2px; outline: 1px solid #9d0006 }
.ͼ0 .cm-panel button { background-color: #fbf1c7; background-image: none; border: none; border-radius: 4px; color: #3c3836; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #d5c4a1; border: none; box-shadow: none; color: #3c3836 }
.ͼ0 .cm-panel.cm-gotoLine { color: #504945; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #ebdbb2; border: none; border-radius: 4px; box-shadow: none; color: #504945 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 1px solid #bdae93 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 1px solid #bdae93 }
.ͼ0 .cm-placeholder { color: #928374 }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #bdae93; border: 3px solid #fbf1c7; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #a89984; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #fbf1c7; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #504945; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #ffc42e80; border-radius: 4px; box-shadow: none; color: #3c3836; outline: 1px solid #af3a03 }
.ͼ0 .cm-searchMatch span { color: #3c3836 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #af3a03; box-shadow: none; color: #fbf1c7; outline: 1px solid #af3a03; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #fbf1c7 }
.ͼ0 .cm-selectionBackground { background-color: #ebdbb2; color: #3c3836; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #ffc42e40; border-radius: 2px; outline: 1px solid #bdae93 }
.ͼ0 .cm-snippetField { background-color: #ffc42e40; border-radius: 2px; outline: 1px dashed #bdae93 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #af3a03 }
.ͼ0 .cm-specialChar { color: #9d0006 }
.ͼ0 .cm-textfield { background-color: #fbf1c7; border: 1px solid #bdae93; border-radius: 4px; color: #504945; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #ebdbb2; border: 1px solid #bdae93; border-radius: 4px; box-shadow: 0 1px 5px rgba(0, 0, 0, 0.1); color: #3c3836; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #ebdbb2; border-top-color: #ebdbb2 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #ebdbb2; border: none }
.ͼ0 .cm-tooltip-autocomplete > ul > li { line-height: 1.3; padding: 4px 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionDetail { color: #7c6f64; font-style: italic }
.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #7c6f64; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: #af3a0315 }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #af3a0330; border: none; border-radius: 3px; color: #3c3836 }
.ͼ0 .cm-tooltip-lint { color: #3c3836; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #bdae93 }
.ͼ0 .cm-trailingSpace { background-color: #f7cfcf80 }
.ͼ0 del { background-color: #f7cfcf80 !important; border: 1px solid #9d000640; border-radius: 3px; color: #9d0006; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #f7cfcf80 !important; border: 1px solid #9d000640; border-radius: 3px; color: #9d0006; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #f7cfcf80 !important; border: 1px solid #9d000640; border-radius: 3px; color: #9d0006; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #d8e5bc80 !important; border: 1px solid #79740e40; border-radius: 3px; color: #79740e; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #d8e5bc80 !important; border: 1px solid #79740e40; border-radius: 3px; color: #79740e; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #ebdbb2 }
.ͼ0.cm-focused { box-shadow: 0 0 0 2px #fbf1c7, 0 0 0 3px #af3a0340; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #ebdbb2; color: #3c3836; outline: none }"
`;

exports[`gruvbox-light export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "gruvboxLight: object",
  "gruvboxLightMergeStyles: object",
]
`;

