.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #928374; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #504945; border: none; border-radius: 3px; color: #fbf1c7 }
.ͼ0 .cm-tooltip-lint { color: #ebdbb2; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #665c54 }
.ͼ0 .cm-trailingSpace { background-color: #3c1f1e80 }
.ͼ0 del { background-color: #3c1f1e80 !important; border: 1px solid #fb493440; border-radius: 3px; color: #fb4934; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #3c1f1e80 !important; border: 1px solid #fb493440; border-radius: 3px; color: #fb4934; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #3c1f1e80 !important; border: 1px solid #fb493440; border-radius: 3px; color: #fb4934; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #32361a80 !important; border: 1px solid #b8bb2640; border-radius: 3px; color: #b8bb26; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #32361a80 !important; border: 1px solid #b8bb2640; border-radius: 3px; color: #b8bb26; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #504945 }
.ͼ0.cm-focused { box-shadow: 0 0 0 2px #282828, 0 0 0 3px #fe801940; outline: none }
.ͼ0.cm-focused > .cm-scroller > .cm-selectionLayer .cm-selectionBackground { background-color: #504945; outline: none }"
`;

exports[`gruvbox-dark export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "gruvboxDark: object",
  "gruvboxDarkMergeStyles: object",
]
`;

