exports[`forest editor UI rules 1`] = `
".ͼ0 { background-color: #1a2a33; border: none; color: #d0d8e0; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #314443aa; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #314443aa; border: none; color: #d0d8e0; font-weight: 500 }
.ͼ0 .cm-button { background-color: #233039; background-image: none; border: none; border-radius: 4px; color: #d0d8e0; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #2d3d47; border: none; box-shadow: none; color: #d0d8e0 }
.ͼ0 .cm-changeGutter { background-color: #233039 }
.ͼ0 .cm-collapsedLines { background: transparent; color: #607d8b }
.ͼ0 .cm-completionInfo { background-color: #2a3b42; border: 1px solid #3e5059; color: #d0d8e0; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #ffb74d80 }
.ͼ0 .cm-content { caret-color: #c594c5; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #2c5a3acc; color: #d0d8e0; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #c594c5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #c594c5; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #763c3c70 }
.ͼ0 .cm-deletedLine { background-color: #763c3c70; border-radius: 3px; color: #ef5350; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #ef5350 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #ff5252 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #4dd0e1 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #4dd0e1 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #ffb74d }
.ͼ0 .cm-diagnosticAction { background-color: #233039; border: none; border-radius: 4px; color: #d0d8e0 }
.ͼ0 .cm-dropCursor { border-left-color: #c594c5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #c594c599; border: none; box-shadow: none; color: #1a2a33 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #607d8b90; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #d0d8e0 }
.ͼ0 .cm-foldPlaceholder { background-color: transparent; border: 1px dotted #ffb74d70; border-radius: 4px; color: #607d8b; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #8fa7b5; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #607d8b90 }
.ͼ0 .cm-gutters { background-color: #233039; border: none; border-right: 1px solid #3e505980; color: #607d8b90; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #607d8b90 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #28513a80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #9ccc65 }
.ͼ0 .cm-insertedLine { background-color: #28513a80; border-radius: 3px; color: #9ccc65; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23ff5252%22%20stroke%3D%22%231a2a33%22%20stroke-width%3D%224%22%2F%3E</svg>') }
