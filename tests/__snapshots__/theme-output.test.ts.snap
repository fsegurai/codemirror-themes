.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #b8bb26 }
.ͼ0 .cm-mergeSpacer { background: #3c3836 }
.ͼ0 .cm-nonmatchingBracket { background-color: #cc241d55; border-radius: 2px; outline: 1px solid #fb4934 }
