exports[`catppuccin-mocha editor UI rules 1`] = `
".ͼ0 { background-color: #1e1e2e; border: none; color: #cdd6f4; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #3a3a5266; border-left: 2px solid #b4befe; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #313244; border: none; color: #cdd6f4; font-weight: 500 }
.ͼ0 .cm-button { background-color: #313244; background-image: none; border: none; border-radius: 4px; color: #cdd6f4; padding: 2px 10px }
