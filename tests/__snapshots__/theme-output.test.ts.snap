exports[`material-light editor UI rules 1`] = `
".ͼ0 { background-color: #ffffff; border: none; color: #212121; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #00000008; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #E0E0E0; border: none; color: #212121; font-weight: 500 }
