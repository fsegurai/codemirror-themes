exports[`solarized-dark editor UI rules 1`] = `
".ͼ0 { background-color: #002b36; border: none; color: #93a1a1; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #99eeff0f; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #073642; border: none; color: #93a1a1; font-weight: 500 }
.ͼ0 .cm-button { background-color: #073642; background-image: none; border: none; border-radius: 4px; color: #93a1a1; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #99eeff0f; border: none; box-shadow: none; color: #93a1a1 }
.ͼ0 .cm-changeGutter { background-color: #00252f }
.ͼ0 .cm-collapsedLines { background: #073642; color: #657b83 }
.ͼ0 .cm-completionInfo { background-color: #073642; border: 1px solid #586e75; color: #93a1a1; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #268bd2 }
.ͼ0 .cm-content { caret-color: #839496; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #02B8FF3F; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #839496; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #839496; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #dc322f20 }
.ͼ0 .cm-deletedLine { background-color: #dc322f20; border-radius: 3px; color: #dc322f; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #dc322f }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #dc322f }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #268bd2 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #268bd2 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #b58900 }
.ͼ0 .cm-diagnosticAction { background-color: #073642; border: none; border-radius: 4px; color: #93a1a1 }
.ͼ0 .cm-dropCursor { border-left-color: #839496; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #83949699; border: none; box-shadow: none; color: #002b36 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #586e75; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #839496 }
.ͼ0 .cm-foldPlaceholder { background-color: #073642; border: 1px dotted #586e7570; border-radius: 4px; color: #657b83; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #657b83; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #586e75 }
.ͼ0 .cm-gutters { background-color: #00252f; border: none; border-right: 1px solid #073642; color: #586e75; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #586e75 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #2aa19820 }
.ͼ0 .cm-inlineChangedLineGutter { background: #859900 }
.ͼ0 .cm-insertedLine { background-color: #2aa19820; border-radius: 3px; color: #859900; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23dc322f%22%20stroke%3D%22%23002b36%22%20stroke-width%3D%224%22%2F%3E</svg>') }
