exports[`cobalt2 editor UI rules 1`] = `
".ͼ0 { background-color: #193549; border: none; color: #fff; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #99eeff33; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: transparent; border: none; color: #fff; font-weight: 500 }
.ͼ0 .cm-button { background-color: #0088ff; background-image: none; border: 1px solid #0d3a58; border-radius: 4px; color: #fff; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #ff9d00; border: 1px solid #0d3a58; box-shadow: none; color: #fff }
.ͼ0 .cm-changeGutter { background-color: #12273866 }
.ͼ0 .cm-collapsedLines { background: transparent; color: #aaa }
.ͼ0 .cm-completionInfo { background-color: #15232d; border: 1px solid #0d3a58; color: #aaa; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #ffc60080 }
.ͼ0 .cm-content { caret-color: #ffc600; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #0050A4; color: #fff; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #ffc600; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #ffc600; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #ee3a4333 }
.ͼ0 .cm-deletedLine { background-color: #ee3a4333; border-radius: 3px; color: #ff628c; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #ff628c }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #A22929 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #0088ff }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #0088ff }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #ffc600 }
.ͼ0 .cm-diagnosticAction { background-color: #0088ff; border: 1px solid #0d3a58; border-radius: 4px; color: #fff }
.ͼ0 .cm-dropCursor { border-left-color: #ffc600; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #ffc60099; border: none; box-shadow: none; color: #193549 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #aaa; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #ffc600 }
.ͼ0 .cm-foldPlaceholder { background-color: transparent; border: 1px dotted #0088ff50; border-radius: 4px; color: #aaa; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #aaa; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #aaa }
.ͼ0 .cm-gutters { background-color: #12273866; border: none; border-right: 1px solid #0d3a58; color: #aaa; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #aaa 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #3ad90033 }
.ͼ0 .cm-inlineChangedLineGutter { background: #a5ff90 }
.ͼ0 .cm-insertedLine { background-color: #3ad90033; border-radius: 3px; color: #a5ff90; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
