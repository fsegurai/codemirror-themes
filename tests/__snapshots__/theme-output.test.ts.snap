.ͼ0 .cm-ghostText { color: #96a4b2; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #96a4b2 }
.ͼ0 .cm-gutters { background-color: #202325; border: none; border-right: 1px solid #505d64; color: #96a4b2; padding-right: 8px }
