exports[`palenight editor UI rules 1`] = `
".ͼ0 { background-color: #292D3E; border: none; color: #A6ACCD; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #2e324817; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #2A2D40; border: none; color: #A6ACCD; font-weight: 500 }
.ͼ0 .cm-button { background-color: #343A50; background-image: none; border: none; border-radius: 4px; color: #A6ACCD; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #3A4058; border: none; box-shadow: none; color: #A6ACCD }
.ͼ0 .cm-changeGutter { background-color: #202331 }
.ͼ0 .cm-collapsedLines { background: #343A50; color: #676E95 }
.ͼ0 .cm-completionInfo { background-color: #343A50; border: 1px solid #3A4058; color: #A6ACCD; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #82AAFF }
.ͼ0 .cm-content { caret-color: #BFC7D5; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #444267; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #BFC7D5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #BFC7D5; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #3e2e3180 }
.ͼ0 .cm-deletedLine { background-color: #3e2e3180; border-radius: 3px; color: #FF5370; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #FF5370 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #FF5370 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #82AAFF }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #82AAFF }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #FFCB6B }
.ͼ0 .cm-diagnosticAction { background-color: #343A50; border: none; border-radius: 4px; color: #A6ACCD }
.ͼ0 .cm-dropCursor { border-left-color: #BFC7D5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #BFC7D599; border: none; box-shadow: none; color: #292D3E }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #676E95; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #A6ACCD }
.ͼ0 .cm-foldPlaceholder { background-color: #343A50; border: 1px dotted #676E9570; border-radius: 4px; color: #676E95; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #676E95; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #676E95 }
