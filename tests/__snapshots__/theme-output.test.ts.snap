exports[`cobalt2 editor UI rules 1`] = `
".ͼ0 { background-color: #193549; border: none; color: #fff; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #99eeff0d; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: transparent; border: none; color: #fff; font-weight: 500 }
.ͼ0 .cm-button { background-color: #83bafe; background-image: none; border: 1px solid #0d3a58; border-radius: 4px; color: #fff; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #fea22f; border: 1px solid #0d3a58; box-shadow: none; color: #fff }
.ͼ0 .cm-changeGutter { background-color: #12273866 }
.ͼ0 .cm-collapsedLines { background: transparent; color: #b7b7b7 }
.ͼ0 .cm-completionInfo { background-color: #15232d; border: 1px solid #0d3a58; color: #b7b7b7; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #ffc60080 }
.ͼ0 .cm-content { caret-color: #ffc600; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #09478e; color: #fff; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #ffc600; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #ffc600; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #ee3a4333 }
