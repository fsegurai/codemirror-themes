exports[`high-contrast-dark export surface 1`] = `
[
  "applyMergeRevertStyles: function",
  "highContrastDark: object",
  "highContrastDarkMergeStyles: object",
]
`;

exports[`high-contrast-light resolved syntax highlighting per tag 1`] = `
