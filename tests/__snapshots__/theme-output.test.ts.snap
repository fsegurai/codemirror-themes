exports[`nord editor UI rules 1`] = `
".ͼ0 { background-color: #2e3440; border: none; color: #d8dee9; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #3b425277; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #3b4252; border: none; color: #d8dee9; font-weight: 500 }
.ͼ0 .cm-button { background-color: #3b4252; background-image: none; border: none; border-radius: 4px; color: #d8dee9; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #434c5e; border: none; box-shadow: none; color: #d8dee9 }
.ͼ0 .cm-changeGutter { background-color: #252a33 }
.ͼ0 .cm-collapsedLines { background: #3b4252; color: #4c566a }
.ͼ0 .cm-completionInfo { background-color: #3b4252; border: 1px solid #4c566a; color: #d8dee9; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #88c0d0 }
.ͼ0 .cm-content { caret-color: #d8dee9; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #434c5e; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #d8dee9; border-left-width: 2px; box-shadow: none }
