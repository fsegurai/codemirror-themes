exports[`material-dark editor UI rules 1`] = `
".ͼ0 { background-color: #212121; border: none; color: #bdbdbd; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #2d333b30; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #252a2c; border: none; color: #bdbdbd; font-weight: 500 }
.ͼ0 .cm-button { background-color: #505d64; background-image: none; border: none; border-radius: 4px; color: #bdbdbd; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #606f7a; border: none; box-shadow: none; color: #bdbdbd }
.ͼ0 .cm-changeGutter { background-color: #202325 }
.ͼ0 .cm-collapsedLines { background: #505d64; color: #96a4b2 }
.ͼ0 .cm-completionInfo { background-color: #505d64; border: 1px solid #96a4b2; color: #bdbdbd; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #56c8d8 }
.ͼ0 .cm-content { caret-color: #a0a4ae; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #ffffff1c; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #a0a4ae; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #a0a4ae; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #4e282880 }
.ͼ0 .cm-deletedLine { background-color: #4e282880; border-radius: 3px; color: #fc7c6e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #fc7c6e }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #fc7c6e }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #56c8d8 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #56c8d8 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #ffad42 }
.ͼ0 .cm-diagnosticAction { background-color: #505d64; border: none; border-radius: 4px; color: #bdbdbd }
.ͼ0 .cm-dropCursor { border-left-color: #a0a4ae; border-left-width: 2px; box-shadow: none }
