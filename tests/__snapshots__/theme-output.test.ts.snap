.ͼ0 .cm-tooltip-autocomplete > ul > li > span.cm-completionIcon { color: #565f89; padding-right: 8px }
.ͼ0 .cm-tooltip-autocomplete > ul > li:hover { background-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul > li[aria-selected] { background-color: #6f7bb630; border: none; border-radius: 3px; color: #c0caf5 }
.ͼ0 .cm-tooltip-lint { color: #c0caf5; padding: 0 }
.ͼ0 .cm-tooltip-section:not(:first-child) { border-top: 1px solid #565f89 }
.ͼ0 .cm-trailingSpace { background-color: #4a393a80 }
.ͼ0 del { background-color: #4a393a80 !important; border: 1px solid #f7768e40; border-radius: 3px; color: #f7768e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del .cm-changedText { background: transparent !important }
.ͼ0 del .cm-deletedText { background: transparent !important }
.ͼ0 del:not(:has(.cm-deletedText)) { background-color: #4a393a80 !important; border: 1px solid #f7768e40; border-radius: 3px; color: #f7768e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 del.cm-deletedLine { background-color: #4a393a80 !important; border: 1px solid #f7768e40; border-radius: 3px; color: #f7768e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 ins.cm-insertedLine { background-color: #3b4a3880 !important; border: 1px solid #9ece6a40; border-radius: 3px; color: #9ece6a; padding: 1px 3px; text-decoration: none }
.ͼ0 ins.cm-insertedLine .cm-changedText { background: transparent !important }
.ͼ0 ins.cm-insertedLine:not(:has(.cm-changedText)) { background-color: #3b4a3880 !important; border: 1px solid #9ece6a40; border-radius: 3px; color: #9ece6a; padding: 1px 3px; text-decoration: none }
.ͼ0:not(.cm-focused) .cm-selectionBackground { background-color: #6f7bb630 }
