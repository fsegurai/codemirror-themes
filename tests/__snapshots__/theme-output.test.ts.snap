exports[`tokyo-night-storm editor UI rules 1`] = `
".ͼ0 { background-color: #24283b; border: none; color: #c0caf5; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #292e427a; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #1f2335; border: none; color: #c0caf5; font-weight: 500 }
.ͼ0 .cm-button { background-color: #282e44; background-image: none; border: none; border-radius: 4px; color: #c0caf5; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #1f2335; border: none; box-shadow: none; color: #c0caf5 }
.ͼ0 .cm-changeGutter { background-color: #1f2335 }
.ͼ0 .cm-collapsedLines { background: #282e44; color: #565f89 }
.ͼ0 .cm-completionInfo { background-color: #282e44; border: 1px solid #565f89; color: #c0caf5; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #7aa2f7 }
.ͼ0 .cm-content { caret-color: #c0caf5; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #6f7bb630; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #c0caf5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #c0caf5; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #4a393a80 }
.ͼ0 .cm-deletedLine { background-color: #4a393a80; border-radius: 3px; color: #f7768e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #f7768e }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #f7768e }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #2ac3de }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #2ac3de }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #ff9e64 }
.ͼ0 .cm-diagnosticAction { background-color: #282e44; border: none; border-radius: 4px; color: #c0caf5 }
.ͼ0 .cm-dropCursor { border-left-color: #c0caf5; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #c0caf599; border: none; box-shadow: none; color: #24283b }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #565f89; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #c0caf5 }
.ͼ0 .cm-foldPlaceholder { background-color: #282e44; border: 1px dotted #565f8970; border-radius: 4px; color: #565f89; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #565f89; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #565f89 }
.ͼ0 .cm-gutters { background-color: #1f2335; border: none; border-right: 1px solid #1f2335; color: #565f89; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #565f89 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #3b4a3880 }
.ͼ0 .cm-inlineChangedLineGutter { background: #9ece6a }
.ͼ0 .cm-insertedLine { background-color: #3b4a3880; border-radius: 3px; color: #9ece6a; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23f7768e%22%20stroke%3D%22%2324283b%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%232ac3de%22%20stroke%3D%22%2324283b%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23ff9e64%22%20stroke%3D%22%2324283b%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #f7768e }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #2ac3de }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #ff9e64 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23f7768e%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%232ac3de%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%232ac3de%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23ff9e64%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #3d59a150; border-radius: 2px; box-shadow: none; outline: 1px solid #7aa2f7 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #4a393a80 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #f7768e }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #3b4a3880 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #9ece6a }
.ͼ0 .cm-mergeSpacer { background: #282e44 }
.ͼ0 .cm-nonmatchingBracket { background-color: #f7768e20; border-radius: 2px; outline: 1px solid #f7768e }
.ͼ0 .cm-panel button { background-color: #282e44; background-image: none; border: none; border-radius: 4px; color: #c0caf5; padding: 2px 10px }
.ͼ0 .cm-panel button:hover { background-color: #1f2335; border: none; box-shadow: none; color: #c0caf5 }
.ͼ0 .cm-panel.cm-gotoLine { color: #c0caf5; padding: 2px 10px }
.ͼ0 .cm-panels { background-color: #282e44; border: none; border-radius: 4px; box-shadow: none; color: #c0caf5 }
.ͼ0 .cm-panels.cm-panels-bottom { border-top: 1px solid #565f89 }
.ͼ0 .cm-panels.cm-panels-top { border-bottom: 1px solid #565f89 }
.ͼ0 .cm-placeholder { color: #565f89 }
.ͼ0 .cm-scroller::-webkit-scrollbar { height: 12px; width: 12px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb { background-color: #414868; border: 3px solid #1f2335; border-radius: 6px }
.ͼ0 .cm-scroller::-webkit-scrollbar-thumb:hover { background-color: #565f89; box-shadow: none }
.ͼ0 .cm-scroller::-webkit-scrollbar-track { background: #1f2335; border: none }
.ͼ0 .cm-search.cm-panel.cm-textfield { border-radius: 4px; color: #c0caf5; padding: 2px 6px }
.ͼ0 .cm-searchMatch { background-color: #7aa2f740; border-radius: 4px; box-shadow: none; color: #c0caf5; outline: 1px solid #7aa2f7 }
.ͼ0 .cm-searchMatch span { color: #c0caf5 }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected { background-color: #7aa2f7; box-shadow: none; color: #24283b; outline: 1px solid #7aa2f7; padding: 2px 6px }
.ͼ0 .cm-searchMatch.cm-searchMatch-selected span { color: #24283b }
.ͼ0 .cm-selectionBackground { background-color: #6f7bb630; outline: none }
.ͼ0 .cm-selectionLayer { z-index: 100 }
.ͼ0 .cm-selectionMatch { background-color: #6f7bb650; border-radius: 2px; outline: 1px solid #41486850 }
.ͼ0 .cm-snippetField { background-color: #6f7bb650; border-radius: 2px; outline: 1px dashed #41486850 }
.ͼ0 .cm-snippetFieldPosition { border-left: 1px dotted #c0caf5 }
.ͼ0 .cm-specialChar { color: #f7768e }
.ͼ0 .cm-textfield { background-color: #24283b; border: 1px solid #565f89; border-radius: 4px; color: #c0caf5; padding: 2px 6px }
.ͼ0 .cm-tooltip { background-color: #282e44; border: 1px solid #565f89; border-radius: 4px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3); color: #c0caf5; padding: 4px 8px }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:after { border-bottom-color: #282e44; border-top-color: #282e44 }
.ͼ0 .cm-tooltip .cm-tooltip-arrow:before { border-bottom-color: transparent; border-top-color: transparent }
.ͼ0 .cm-tooltip-autocomplete > ul { background-color: #282e44; border: none }
