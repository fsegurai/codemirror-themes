exports[`github-light editor UI rules 1`] = `
".ͼ0 { background-color: #ffffff; border: none; color: #24292e; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #BBDFFF20; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #f1f8ff; border: none; color: #24292e; font-weight: 500 }
.ͼ0 .cm-button { background-color: #ffffff; background-image: none; border: none; border-radius: 4px; color: #24292e; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #f5f5f5; border: none; box-shadow: none; color: #24292e }
.ͼ0 .cm-changeGutter { background-color: #f6f8fa }
.ͼ0 .cm-collapsedLines { background: #79b8ff40; color: #6e7781 }
.ͼ0 .cm-completionInfo { background-color: #f8f9fa; border: 1px solid #e1e4e8; color: #24292e; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #0366d680 }
.ͼ0 .cm-content { caret-color: #24292e; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #BBDFFF; color: #24292e; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #24292e; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #24292e; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #ffebe980 }
.ͼ0 .cm-deletedLine { background-color: #ffebe980; border-radius: 3px; color: #cf222e; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #cf222e }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #cb2431 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #0969da }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #0969da }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #b08800 }
.ͼ0 .cm-diagnosticAction { background-color: #ffffff; border: none; border-radius: 4px; color: #24292e }
.ͼ0 .cm-dropCursor { border-left-color: #24292e; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #24292e99; border: none; box-shadow: none; color: #ffffff }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #6e7781; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #24292e }
.ͼ0 .cm-foldPlaceholder { background-color: #79b8ff40; border: 1px dotted #e1e4e870; border-radius: 4px; color: #6e7781; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #959da5; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #6e7781 }
.ͼ0 .cm-gutters { background-color: #f6f8fa; border: none; border-right: 1px solid #e1e4e8; color: #6e7781; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #6e7781 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #e6ffec80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #0f6d31 }
.ͼ0 .cm-insertedLine { background-color: #e6ffec80; border-radius: 3px; color: #0f6d31; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23cb2431%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%230969da%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23b08800%22%20stroke%3D%22%23ffffff%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #cb2431 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #0969da }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #b08800 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23cb2431%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%230969da%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
