exports[`gruvbox-dark editor UI rules 1`] = `
".ͼ0 { background-color: #282828; border: none; color: #ebdbb2; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #3c383660; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #3c3836; border: none; color: #ebdbb2; font-weight: 500 }
.ͼ0 .cm-button { background-color: #3c3836; background-image: none; border: none; border-radius: 4px; color: #ebdbb2; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #504945; border: none; box-shadow: none; color: #ebdbb2 }
.ͼ0 .cm-changeGutter { background-color: #3c3836 }
.ͼ0 .cm-collapsedLines { background: #3c3836; color: #b6a797 }
.ͼ0 .cm-completionInfo { background-color: #3c3836; border: 1px solid #665c54; color: #ebdbb2; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #fabd2f }
.ͼ0 .cm-content { caret-color: #fa8d44; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #443d39; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #fa8d44; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #fa8d44; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #3c1f1e80 }
.ͼ0 .cm-deletedLine { background-color: #3c1f1e80; border-radius: 3px; color: #fb8a77; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #fb8a77 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #fb8a77 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #8eb1a3 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #8eb1a3 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #fabd2f }
.ͼ0 .cm-diagnosticAction { background-color: #3c3836; border: none; border-radius: 4px; color: #ebdbb2 }
.ͼ0 .cm-dropCursor { border-left-color: #fa8d44; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #fa8d4499; border: none; box-shadow: none; color: #282828 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #b6a797; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #ebdbb2 }
.ͼ0 .cm-foldPlaceholder { background-color: #3c3836; border: 1px dotted #665c54; border-radius: 4px; color: #b6a797; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #b6a797; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #b6a797 }
.ͼ0 .cm-gutters { background-color: #3c3836; border: none; border-right: 1px solid #504945; color: #b6a797; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #b6a797 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #32361a80 }
.ͼ0 .cm-inlineChangedLineGutter { background: #b8bb26 }
.ͼ0 .cm-insertedLine { background-color: #32361a80; border-radius: 3px; color: #b8bb26; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23fb8a77%22%20stroke%3D%22%23282828%22%20stroke-width%3D%224%22%2F%3E</svg>') }
