exports[`synthwave-84 editor UI rules 1`] = `
".ͼ0 { background-color: #262335; border: none; color: #ffffff; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #2a213955; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #34294f; border: none; color: #ff7edb; font-weight: 500 }
.ͼ0 .cm-button { background-color: #2a2139; background-image: none; border: none; border-radius: 4px; color: #72f1b8; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #34294f; border: none; box-shadow: 0 0 8px #72f1b8; color: #72f1b8 }
.ͼ0 .cm-changeGutter { background-color: #241b2f }
.ͼ0 .cm-collapsedLines { background: #2a2139; color: #72f1b8 }
.ͼ0 .cm-completionInfo { background-color: #2a2139; border: 1px solid #72f1b8; color: #ffffff; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #72f1b8 }
.ͼ0 .cm-content { caret-color: #ff7edb; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #34294f; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #ff7edb; border-left-width: 2px; box-shadow: 0 0 8px #ff7edb }
.ͼ0 .cm-cursor-secondary { border-left-color: #ff7edb; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #fe445030 }
.ͼ0 .cm-deletedLine { background-color: #fe445030; border-radius: 3px; color: #fe4450; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #fe4450 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #fe4450 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #36f9f6 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #36f9f6 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #fede5d }
.ͼ0 .cm-diagnosticAction { background-color: #2a2139; border: none; border-radius: 4px; color: #72f1b8 }
.ͼ0 .cm-dropCursor { border-left-color: #ff7edb; border-left-width: 2px; box-shadow: 0 0 8px #ff7edb }
.ͼ0 .cm-fat-cursor { background-color: #ff7edb99; border: none; box-shadow: 0 0 8px #ff7edb; color: #262335 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #495495; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #72f1b8 }
.ͼ0 .cm-foldPlaceholder { background-color: #2a2139; border: 1px dotted #72f1b870; border-radius: 4px; color: #72f1b8; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #495495; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #495495 }
.ͼ0 .cm-gutters { background-color: #241b2f; border: none; border-right: 1px solid #34294f; color: #495495; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #495495 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #72f1b830 }
.ͼ0 .cm-inlineChangedLineGutter { background: #72f1b8 }
.ͼ0 .cm-insertedLine { background-color: #72f1b830; border-radius: 3px; color: #72f1b8; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23fe4450%22%20stroke%3D%22%23262335%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%2336f9f6%22%20stroke%3D%22%23262335%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23fede5d%22%20stroke%3D%22%23262335%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #fe4450 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #36f9f6 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #fede5d }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23fe4450%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2336f9f6%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%2336f9f6%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
