exports[`tokyo-night-day editor UI rules 1`] = `
".ͼ0 { background-color: #e1e2e7; border: none; color: #3760bf; font-family: JetBrains Mono, Consolas, monospace; font-size: 14px }
.ͼ0 .cm-activeLine { background-color: #5F5FAF5A; border-left: none; border-radius: 2px; border-right: none; z-index: 1 }
.ͼ0 .cm-activeLineGutter { background-color: #e9e9ec; border: none; color: #3760bf; font-weight: 500 }
.ͼ0 .cm-button { background-color: #e9e9ec; background-image: none; border: none; border-radius: 4px; color: #3760bf; padding: 2px 10px }
.ͼ0 .cm-button:hover { background-color: #d5d6db; border: 1px solid #99a7df; box-shadow: none; color: #3760bf }
.ͼ0 .cm-changeGutter { background-color: #d5d6db }
.ͼ0 .cm-collapsedLines { background: #e9e9ec; color: #848cb5 }
.ͼ0 .cm-completionInfo { background-color: #e9e9ec; border: 1px solid #8c91a840; color: #3760bf; padding: 4px 8px }
.ͼ0 .cm-completionMatchedText { color: inherit; font-weight: bold; text-decoration: underline; text-decoration-color: #007197 }
.ͼ0 .cm-content { caret-color: #3760bf; line-height: 1.6 }
.ͼ0 .cm-content ::selection { background-color: #99a7df40; outline: none }
.ͼ0 .cm-crosshair { cursor: crosshair }
.ͼ0 .cm-cursor { border-left-color: #3760bf; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-cursor-secondary { border-left-color: #3760bf; opacity: 0.6 }
.ͼ0 .cm-deletedChunk { background-color: #f52a6520 }
.ͼ0 .cm-deletedLine { background-color: #f52a6520; border-radius: 3px; color: #f52a65; padding: 1px 3px; text-decoration: line-through }
.ͼ0 .cm-deletedLineGutter { background: #f52a65 }
.ͼ0 .cm-diagnostic-error { background-color: transparent; border-left: 3px solid #f52a65 }
.ͼ0 .cm-diagnostic-hint { border-left: 3px solid #007197 }
.ͼ0 .cm-diagnostic-info { background-color: transparent; border-left: 3px solid #007197 }
.ͼ0 .cm-diagnostic-warning { background-color: transparent; border-left: 3px solid #b15c00 }
.ͼ0 .cm-diagnosticAction { background-color: #e9e9ec; border: none; border-radius: 4px; color: #3760bf }
.ͼ0 .cm-dropCursor { border-left-color: #3760bf; border-left-width: 2px; box-shadow: none }
.ͼ0 .cm-fat-cursor { background-color: #3760bf99; border: none; box-shadow: none; color: #e1e2e7 }
.ͼ0 .cm-foldGutter { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-foldGutter .cm-gutterElement { color: #848cb5; cursor: pointer }
.ͼ0 .cm-foldGutter .cm-gutterElement:hover { color: #3760bf }
.ͼ0 .cm-foldPlaceholder { background-color: #e9e9ec; border: 1px dotted #848cb570; border-radius: 4px; color: #848cb5; margin: 0 2px; padding: 0 5px }
.ͼ0 .cm-ghostText { color: #848cb5; opacity: 0.5 }
.ͼ0 .cm-gutter-lint { color: #848cb5 }
.ͼ0 .cm-gutters { background-color: #d5d6db; border: none; border-right: 1px solid #d5d6db; color: #848cb5; padding-right: 8px }
.ͼ0 .cm-highlightSpace { background-image: radial-gradient(circle at 50% 55%, #848cb5 20%, transparent 0) }
.ͼ0 .cm-inlineChangedLine { background-color: #58753920 }
.ͼ0 .cm-inlineChangedLineGutter { background: #587539 }
.ͼ0 .cm-insertedLine { background-color: #58753920; border-radius: 3px; color: #587539; padding: 1px 3px; text-decoration: none }
.ͼ0 .cm-lineNumbers { font-size: 0.9em; line-height: 1.78 }
.ͼ0 .cm-lint-marker { height: 1em; width: 1em }
.ͼ0 .cm-lint-marker-error { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Ccircle%20cx%3D%2220%22%20cy%3D%2220%22%20r%3D%2215%22%20fill%3D%22%23f52a65%22%20stroke%3D%22%23e1e2e7%22%20stroke-width%3D%224%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-info { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23007197%22%20stroke%3D%22%23e1e2e7%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M5%205L35%205L35%2035L5%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lint-marker-warning { content: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">%3Cpath%20fill%3D%22%23b15c00%22%20stroke%3D%22%23e1e2e7%22%20stroke-width%3D%224%22%20stroke-linejoin%3D%22round%22%20d%3D%22M20%206L37%2035L3%2035Z%22%2F%3E</svg>') }
.ͼ0 .cm-lintPoint-error { border-bottom: 2px wavy #f52a65 }
.ͼ0 .cm-lintPoint-info { border-bottom: 2px wavy #007197 }
.ͼ0 .cm-lintPoint-warning { border-bottom: 2px wavy #b15c00 }
.ͼ0 .cm-lintRange-error { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23f52a65%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-hint { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23007197%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-info { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23007197%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-lintRange-warning { background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="6" height="3">%3Cpath%20d%3D%22m0%202.5%20l2%20-1.5%20l1%200%20l2%201.5%20l1%200%22%20stroke%3D%22%23b15c00%22%20fill%3D%22none%22%20stroke-width%3D%22.7%22%2F%3E</svg>') }
.ͼ0 .cm-matchingBracket { background-color: #0e639c20; border-radius: 2px; box-shadow: none; outline: 1px solid #007197 }
.ͼ0 .cm-merge-a .cm-changedLine { background-color: #f52a6520 }
.ͼ0 .cm-merge-a .cm-changedLineGutter { background: #f52a65 }
.ͼ0 .cm-merge-b .cm-changedLine { background-color: #58753920 }
.ͼ0 .cm-merge-b .cm-changedLineGutter { background: #587539 }
.ͼ0 .cm-mergeSpacer { background: #d5d6db }
.ͼ0 .cm-nonmatchingBracket { background-color: #f52a6520; border-radius: 2px; outline: 1px solid #f52a65 }
.ͼ0 .cm-panel button { background-color: #e9e9ec; background-image: none; border: none; border-radius: 4px; color: #3760bf; padding: 2px 10px }
